{
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                "options": {
                    "regex": "/^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\\([a-z0-9-]+\\))?!?: .+/",
                    "error": "Заголовок должен начинаться с типа, например: build: add Pest"
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting"
            },
            {
                "action": "./vendor/bin/pint --test"
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "./vendor/bin/pest"
            }
        ]
    }
}
